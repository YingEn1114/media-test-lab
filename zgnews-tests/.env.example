# 示例配置不自动加载。请在自己的终端 export 对应变量后运行 ./start.sh。
# 不要把真实 API Key、SMTP 密码或管理员令牌提交到 Git。

ZG_HOST=127.0.0.1
ZG_PORT=8090
ZG_BASE_URL=https://www.zhengguannews.cn
# ZG_DB=/absolute/path/to/platform.db
# 首次初始化可指定管理员令牌；不填则生成本机权限为0600的令牌文件。
# ZG_ADMIN_TOKEN=replace-with-a-long-random-token

# OpenAI 兼容服务。未配置时不会自动将演示用例判定为 AI 评审通过。
ZG_AI_BASE_URL=
ZG_AI_KEY=
ZG_AI_MODEL=gpt-4o-mini
ZG_AI_TIMEOUT=60

# 专用本地 bare 资产仓库；不得填写本项目工作仓库的 .git 或远程 URL。
# 不填时使用 <ZG_DB>.assets.git。ZG_ASSET_REPO 优先于 ZG_GIT_REPO。
# ZG_GIT_REPO=/absolute/path/to/generated-assets.git
ZG_GIT_BRANCH=main
ZG_GIT_AUTHOR_NAME="QA Asset Bot"
ZG_GIT_AUTHOR_EMAIL=qa-assets@localhost

# 当前版本仅保存本地发件箱，设置以下变量也不会自动向外发送。
# ZG_SMTP_HOST=
# ZG_SMTP_PORT=465
# ZG_SMTP_USER=
# ZG_SMTP_PASS=
# ZG_SMTP_TLS=1
